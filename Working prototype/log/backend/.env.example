# AuthSentinel Backend Configuration
# Copy this file to .env.local and fill in your values

# Resend Email Configuration
# Get your Resend API key from: https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key-here

# The email address to send from (must be verified with Resend)
RESEND_FROM_EMAIL=noreply@yourdomain.com

# JWT Configuration
# Secret key for JWT signing (keep this secure and private!)
JWT_SECRET_KEY=Jw8mK_vL9pQ2rX4sD5fG6hY7jZ0aB1cE2dF3gH4iJ5kL6mN7oP8qR9sT0uV1wX2y

# Frontend URL
# Used for verification email links
FRONTEND_URL=http://localhost:5173

# For production, use:
# FRONTEND_URL=https://yourdomain.com
